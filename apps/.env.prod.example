API_BASE_URL=https://api.inovasionline.com/api/v1
APP_BASE_URL=https://api.inovasionline.com
GOOGLE_SERVER_CLIENT_ID=

# Reverb must be reachable here (reverse-proxy wss://<host>/app to the reverb container); chat falls back to polling otherwise.
REVERB_HOST=api.inovasionline.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_APP_KEY=

# Peta Lacak Pengiriman: maptiler (default) atau google (butuh API key Google di gradle.properties/Info.plist).
# MAPTILER_KEY dari cloud.maptiler.com; kosong = tile OpenStreetMap (hanya untuk testing).
MAP_PROVIDER=maptiler
MAPTILER_KEY=
