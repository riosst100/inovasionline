# Docker Compose overrides. Copy to `.env` and adjust as needed.
UID=1000
GID=1000

# Host ports
BACKEND_PORT=8000
BACKEND_ALT_PORT=8001
REVERB_PORT=8080
DB_PORT=5432
REDIS_PORT=6379

API_URL=http://localhost:8000

DB_DATABASE=inovasionline_marketplace
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Admin (Next.js)
ADMIN_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8001/api

# Frontend (Next.js, inovasionline.com)
FRONTEND_PORT=3001
FRONTEND_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_SITE_URL=http://localhost:3001
